# ==============================================================================
# Huginn (Rust / egui) — Git Attributes & Line Ending Normalization
# ==============================================================================

# Default behavior: auto-detect text files and normalize to LF in the index
* text=auto

# Rust source code, Cargo manifests, and lockfiles
*.rs   text eol=lf diff=rust
*.toml text eol=lf
*.lock text eol=lf

# Localization dictionaries, configurations, workflows, and Markdown docs
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Embedded multilingual text assets (ABOUT, CLC, COPYRIGHT, EULA, LICENSES, NOTICES, PRIVACY_POLICY, RELEASE)
src/assets/**/*.txt text eol=lf
*.txt  text=auto

# Windows native scripts, batch files, and Inno Setup installers require CRLF
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.iss  text eol=crlf

# Binary assets, icons, documents, compiled artifacts, databases, and quarantine containers
*.png     binary
*.ico     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.pdf     binary
*.exe     binary
*.dll     binary
*.pdb     binary
*.zip     binary
*.db      binary
*.sqlite  binary
*.sqlite3 binary
*.quar    binary

# GitHub Linguist classification rules
Cargo.lock          linguist-generated=true
version/Cargo.lock  linguist-generated=true
src/assets/docs/**  linguist-documentation=true
MANUAL.md           linguist-documentation=true
OBSERVACAO.md       linguist-documentation=true
version/**          linguist-vendored=true
